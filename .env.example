PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional: full path to yt-dlp executable (Windows users may set this if it is not on PATH)
# YT_DLP_PATH=C:\tools\yt-dlp.exe
# Optional: full path to ffmpeg executable (Windows users may set this if it is not on PATH)
# FFMPEG_PATH=C:\tools\ffmpeg.exe
MAX_DOWNLOAD_BYTES=104857600
MAX_ACTIVE_DOWNLOADS=2

# Admin Analytics Dashboard Security
ADMIN_PASSWORD=your_secure_random_admin_password_here

# Persistent Analytics Database (PostgreSQL on Render/Supabase/Neon)
# Leave blank to use built-in resilient in-memory analytics mode
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require
